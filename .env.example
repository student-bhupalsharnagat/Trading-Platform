# Authentication & JWT
JWT_SECRET="vertex_jwt_secret_key_change_in_production"

# Database Configuration (PostgreSQL / Persistent Storage)
DATABASE_URL="postgresql://user:password@localhost:5432/vertex_db"

# SMTP Email Configuration for OTP Verification
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@vertex-trading.com"

# Application Settings
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Redis Configuration (Distributed Cache, Pub/Sub, Rate Limiting)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Server-to-Server Internal Authentication (Central Admin <-> Trading Platform)
TRADING_PLATFORM_BASE_URL="http://localhost:3000"
INTERNAL_COMMUNICATION_SECRET=""
INTERNAL_REQUEST_MAX_AGE_MS="30000"

# GEMINI_API_KEY: Optional for future assistant features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Injected automatically at runtime
APP_URL="MY_APP_URL"

