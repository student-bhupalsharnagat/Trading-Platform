# ==============================================================================
# VERTEX Trading Platform - Production & Render Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
TRADING_PLATFORM_BASE_URL=https://your-trading-platform.onrender.com
CLIENT_URL=https://your-trading-platform.onrender.com

# ------------------------------------------------------------------------------
# 2. Central Admin Panel Server-to-Server Integration (CRITICAL)
# ------------------------------------------------------------------------------
CENTRAL_ADMIN_BASE_URL=https://your-central-admin.onrender.com
INTERNAL_COMMUNICATION_SECRET=at_least_32_chars_random_shared_hmac_secret_here
INTERNAL_REQUEST_MAX_AGE_MS=30000

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security (CRITICAL)
# ------------------------------------------------------------------------------
JWT_SECRET=at_least_32_chars_random_secure_jwt_secret_here

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database (Render Managed PostgreSQL or external cloud DB)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@hostname:5432/dbname
PG_SSL=true
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_MAX_POOL_SIZE=20
PG_MIN_POOL_SIZE=2

# ------------------------------------------------------------------------------
# 5. Redis Distributed Cache & Pub/Sub (Optional - defaults to in-memory)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:password@hostname:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
USE_REAL_REDIS=false

# ------------------------------------------------------------------------------
# 6. CORS & WebSocket Origins Security
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-trading-platform.onrender.com,https://your-central-admin.onrender.com
WEBSOCKET_ALLOWED_ORIGINS=https://your-trading-platform.onrender.com,https://your-central-admin.onrender.com
STRICT_PRODUCTION_CONFIG=false

# ------------------------------------------------------------------------------
# 7. Broker Execution Gateway & Webhook Security
# ------------------------------------------------------------------------------
BROKER_SANDBOX_API_KEY=
BROKER_SANDBOX_API_SECRET=
BROKER_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. Server-Side Email & OTP Providers (Never expose to frontend)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VERTEX Security <security@vertex-trading.com>
EMAIL_FROM=VERTEX Security <security@vertex-trading.com>
RESEND_API_KEY=
EMAIL_OTP_PROVIDER=
OTP_PROVIDER=
OTP_SECRET=
ENABLE_DEV_OTP=false

# SMS Providers (Twilio / HTTP Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_MESSAGING_SERVICE_SID=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=VERTEX
