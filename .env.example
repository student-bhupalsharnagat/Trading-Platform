# Authentication & JWT
JWT_SECRET="vertex_jwt_secret_key_change_in_production"

# Database Configuration (PostgreSQL / Persistent Storage)
DATABASE_URL="postgresql://user:password@localhost:5432/vertex_db"

# SMTP Email Configuration for OTP Verification
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@vertex-trading.com"

# Application Settings
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# GEMINI_API_KEY: Optional for future assistant features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Injected automatically at runtime
APP_URL="MY_APP_URL"

